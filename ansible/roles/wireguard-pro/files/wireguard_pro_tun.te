module wireguard_pro_tun 1.1;

require {
    type container_t;
    type container_file_t;
    type tun_tap_device_t;
    class chr_file { getattr ioctl open read write };
    class sock_file { watch };
}

# Let rootless containers use /dev/net/tun so wireguard-pro can create wg0
allow container_t tun_tap_device_t:chr_file { getattr ioctl open read write };

# wireguard-go puts an inotify watch on its UAPI socket (/var/run/wireguard/wg0.sock)
allow container_t container_file_t:sock_file watch;
