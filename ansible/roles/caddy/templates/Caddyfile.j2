{
	# socket‑activation: fd3=80/tcp, fd4=443/tcp, fd5=443/udp, fd6=admin
	admin fd/6
}

http://vpn.jackturk.dev http://forge.jackturk.dev http://vault.jackturk.dev http://jackturk.dev {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri} permanent
}

https://vpn.jackturk.dev https://forge.jackturk.dev https://vault.jackturk.dev https://jackturk.dev {
	bind fd/4 {
		protocols h1 h2
	}
	encode gzip
	log

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 1) Preflight matcher
	@preflight {
		method OPTIONS
		path /login* /api/* /serverinfo
	}

	# 2) For any preflight, remove ETag & disable caching
	header @preflight -ETag
	header @preflight Cache-Control "no-store, no-cache"

	# 3) Now respond 204 every time
	respond @preflight 204

	@portfolio host jackturk.dev
	handle @portfolio {
		reverse_proxy /* host.containers.internal:8081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	@vpn host vpn.jackturk.dev
	handle @vpn {
		@vpn_denied not remote_ip {{ vaulted_secrets.admin_allow_ips | join(' ') }}
		respond @vpn_denied 403

		reverse_proxy /* host.containers.internal:51819 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	@forge host forge.jackturk.dev
	handle @forge {
		reverse_proxy host.containers.internal:3000
	}

	@vault host vault.jackturk.dev
	handle @vault {
		@vault_admin_denied {
			path /admin*
			not remote_ip {{ vaulted_secrets.admin_allow_ips | join(' ') }}
		}
		respond @vault_admin_denied 403

		reverse_proxy /* host.containers.internal:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
